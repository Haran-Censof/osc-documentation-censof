 "businessRules": [
  {
   "group": "Dashboard & Pelaporan",
   "rules": [
    {
     "code": null,
     "text": "Dashboard mesti memaparkan KPI rasmi yang disahkan oleh PBT, termasuk volum permohonan, masa proses, tahap kelulusan, bilangan aduan, dan ketakpatuhan."
    },
    {
     "code": null,
     "text": "Semua KPI mesti menggunakan data terkini daripada modul berkaitan (Modul 1–8)."
    },
    {
     "code": null,
     "text": "Pengguna mesti boleh memilih tempoh masa (harian, mingguan, bulanan, tahunan) untuk memaparkan statistik."
    },
    {
     "code": null,
     "text": "Semua penapisan statistik (status, kawasan, kategori, pegawai) mesti menghasilkan paparan yang konsisten dan sah."
    },
    {
     "code": null,
     "text": "Fungsi drill-down/drill-through hanya boleh memaparkan data yang pengguna diberi kebenaran untuk melihat."
    },
    {
     "code": null,
     "text": "Konfigurasi paparan kegemaran (favorite Dashboards) mesti disimpan bagi setiap pengguna secara individu."
    },
    {
     "code": null,
     "text": "Laporan pratakrif mesti menggunakan template rasmi yang ditetapkan oleh pentadbir sistem."
    },
    {
     "code": null,
     "text": "Pengguna hanya boleh menjana laporan yang termasuk dalam skop peranan mereka."
    },
    {
     "code": null,
     "text": "Semua laporan mesti dijana menggunakan parameter sah (tarikh, kategori, status, PBT)."
    },
    {
     "code": null,
     "text": "Penjadualan penghantaran laporan (harian / mingguan / bulanan) mesti dilakukan mengikut jadual yang ditetapkan tanpa konflik masa."
    },
    {
     "code": null,
     "text": "Laporan yang dihantar melalui e-mel wajib disulitkan atau dilindungi kata laluan jika mengandungi maklumat sensitif."
    },
    {
